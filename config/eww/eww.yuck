(include "eww_widgets.yuck")

(defwindow userinfo
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "30"
    :y "50"
    :width "100"
    :height "100"
    :anchor "bottom right")
  (userinfobox)
)


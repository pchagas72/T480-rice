(include "eww_widgets.yuck")

(defwindow userinfo
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "10"
    :y "200"
    :width "100"
    :height "100"
    :anchor "top right")
  (userinfobox)
)

(defwindow powermenu
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "10"
    :y "200"
    :width "100"
    :height "100"
    :anchor "top right")
  (powermenu)
)

(defwindow wallpapersbox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "140"

(include "eww_widgets.yuck")

;; Main bar, definition is unchanged but will use the new widget style
(defwindow userinfo
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "30"
    :y "30"
    :height "75"
    :width "250"
    :anchor "bottom right")
  (userinfobox)
)

;; Power menu, now opens in the foreground for proper layering
(defwindow powermenu
  :monitor '[0]'
  :stacking "fg"
  :namespace "eww"
  :geometry (geometry
    :x "30"
    :y "30"
    :height "50"
    :width "250"
    :anchor "bottom right")
  (powermenu)
)

(defwindow appmenubox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :width "700"
    :height "350"
    :anchor "center")
  (appmenubox)
)

(defwindow closeappmenubox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "105"
    :y "35"
    :height "75"
    :width "250"
    :anchor "bottom right")
  (closeappmenubox)
)

(defwindow infobox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "20"
    :y "30"
    :width "100"
    :height "100"
    :anchor "top left")
  (infobox)
)

(defpoll DAY :interval "1s" '~/.config/eww/scripts/day_format.sh')
(defpoll MONTH :interval "1s" '~/.config/eww/scripts/month_format.sh')
(defpoll YEAR :interval "1s" '~/.config/eww/scripts/year_format.sh')
(defpoll HOUR :interval "1s" '~/.config/eww/scripts/hour_format.sh')
(defpoll SPOT_NAME :interval "5s" '~/.config/eww/scripts/spotify_info.sh --name')
(defpoll SPOT_IMAGE :interval "5s" '~/.config/eww/scripts/spotify_info.sh --image')

(include "eww_vars.yuck")

(defwidget userinfobox []
  (box :class "userinfo-parent" :orientation "h" :spacing 5 :space-evenly true
    (button :onclick "eww open appmenubox; eww open closeappmenubox" :class "button"
      (label :class "icon-label"  :text "󰀻")
    )
    (button :onclick "eww open powermenu" :class "button"
      (label :class "icon-label"  :text "⭘")
    )
    (button :onclick "update_wallpaper.sh"  :class "button"
      (label :class "icon-label"  :text "󰸉")
    )
  )
)

(defwidget powermenu []
  (box :class "container" :orientation "h" :spacing 5
    (button :onclick "systemctl poweroff" :class "poweroff-button"
      (label :class "icon-label"  :text "󰐥")
    )
    (button :onclick "eww close powermenu" :class "button"
      (label :class "icon-label"  :text "⨯")
    )
    (button :onclick "systemctl suspend"  :class "suspend-button"
      (label :class "icon-label"  :text "")
    )
  )
)

(defwidget appmenubox []
    (box :height "200"
    :width "700"
    :halign "center"
    :valign "top" 
    :spacing 10
    :orientation "v"
    :class "container"
        (box :height "200" :width "700" :halign "center" :valign "center" :class "container_borderless" :orientation "h"
        (button :onclick "gimp & disown; eww close appmenubox;
 toggle_eww.sh --close" :class "button" :height "100"
            (label :class "icon-label"  :text "")
        )
        (button :onclick "spotify-launcher & disown; eww close appmenubox; toggle_eww.sh --close" :class "button" :height "100"
            (label :class "icon-label"  :text "")
        )
        (button :onclick "steam & disown; eww close appmenubox; toggle_eww.sh --close" :class "button" :height "100"
             (label :class "icon-label"  :text "")
        )
        )
        (box :height "200" :width "700" :halign "center" :valign "center" :class "container_borderless" :orientation "h"
        (button :onclick "brave & disown; eww close appmenubox; toggle_eww.sh --close" :class "button" :height "100"
            (label :class "icon-label"  :text "󰖟")
        )
        (button :onclick "qbittorrent & disown; eww close appmenubox; toggle_eww.sh --close" :class "button" :height "100"
            (label :class "icon-label"  :text "")
        )
        (button :onclick "obs & disown;
 eww close appmenubox; toggle_eww.sh --close" :class "button" :height "100"
            (label :class "icon-label"  :text "")
        )
        )
    )
)

(defwidget closeappmenubox []
    (box :height "75" :width "75" :halign "center" :valign "center" :class "userinfo-child"
        (button :onclick "eww close appmenubox closeappmenubox" :class "button"
            (label :class "icon-label"  :text "󰅗")
         )
    )
)

(defwidget infobox []
    (box :height "280" :width "320" :halign "center" :valign "center" :class "infobox" :orientation "v"
        (label :markup TIME)
        (label :markup SYSTEMINFO)
    )
)

(include "eww_vars.yuck")

(defwidget daybox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text DAY)
  )
)

(defwidget monthbox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text MONTH)
  )
)

(defwidget yearbox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text YEAR)
  )
)

(defwidget userinfobox []
  (centerbox :height "100" :width "340" :halign "center" :valign "center" :class "userinfo-parent"
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "alacritty & disown" :class "button"
        (label :class "icon-label"  :text "")
      )
    )
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "eww open powermenu" :class "button"
        (label :class "icon-label"  :text "⭘")
      )
    )
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "eww open wallpapersbox && eww open closewallpapersbox"  :class "button"
        (label :class "icon-label"  :text "󰸉")
      )
      )
  )
)

(defwidget closewallpapersbox []
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
        (button :onclick "eww close wallpapersbox closewallpapersbox" :class "button"
            (label :class "icon-label"  :text "")
        )
    )
)


(defwidget powermenu []
  (centerbox :height "100" :width "340" :halign "center" :valign "center" :class "userinfo-parent"
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "systemctl poweroff" :class "poweroff-button"
        (label :class "icon-label"  :text "󰐥")
      )
    )
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "eww close powermenu" :class "button"
        (label :class "icon-label"  :text "⨯")
      )
    )
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "systemctl suspend"  :class "suspend-button"
        (label :class "icon-label"  :text "")
      )
    )
  )
)

(defwidget imagemenubox []
  (box :height "400" :width "200" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text DAY)
  )
)

(defwidget clockbox []
  (box :height "100" :width "340" :halign "center" :valign "center" :class "container" :orientation "v"
    (label :class "label"  :text HOUR)
  )
  )

(defwidget wallpapersbox []
    (box :height "340" :width "120" :halign "center" :valign "center" :class "container" :orientation "v"
        (button :onclick "change_wallpaper.sh --knight" :style "background-image: url('images/icons/hollow_knight.png');" :class "button_wallpaper")
        (button :onclick "change_wallpaper.sh --japan" :style "background-image: url('images/icons/japan.png');" :class "button_wallpaper")
        (button :onclick "change_wallpaper.sh --fishes" :style "background-image: url('images/icons/two_fishes.png');" :class "button_wallpaper")
    )
)

{
    "height": 40,
    "spacing": 5,
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,

    "modules-left": [
        "backlight",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
    ],
    "modules-right": [
        "clock",
        "custom/themeswitcher",
        "battery",
        "mpris",
    ],
    "modules-center": [
        "hyprland/workspaces",
    ],

    "custom/themeswitcher": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Click to change theme",
        "on-click": "~/.config/hypr/scripts/next_wallpaper.sh",
        "on-click-right": "~/.config/hypr/scripts/wallpaper_rotate.sh"
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "warp-on-scroll": false,
        "enable-bar-scroll": true,
        "disable-scroll-wraparound": true,
        "active-only": false,
        "format": "{icon}",
        "format-icons": {
            "1": ">_",
            "2": "www",
            "3": "3",
            "4": "4",
            "5": "5",
            "6": "6",
            "7": "7",
            "8": "8",
            "9": "9",
            "default": "•"
        }
    },

    "mpris": {
        "format": "[   {status_icon} | {dynamic} ]",
        "interval": 1,
        "dynamic-len": 40,
        "status-icons": {
            "playing": "▶",
            "paused": "⏸",
            "stopped": ""
        },
        "dynamic-order": ["artist"]
    },

    "network": {
        "interface": "wlp3s0",
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀 LAN",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ipaddr}\n{ssid} ({signalStrength}%)",
        "on-click": "nm-applet",
        "format-icons": [ "󰤯", "󰤟", "󰤢", "󰤥", "󰤨" ]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "on-click": "wlogout"
    },

    "backlight": {
        "device": "intel_backlight",
        "states": {
            "critical_high": 95,
            "normal": 30,
            "critical_low": 0
        },
        "format": "{percent}% {icon}",
        "tooltip": false,
        "format-icons": {
            "default": [
                "  █░░░░░░░░░",
                "  ██░░░░░░░░",
                "  ███░░░░░░░",
                "  ████░░░░░░",
                "  █████░░░░░",
                "  ██████░░░░",
                "  ███████░░░",
                "  ████████░░",
                "  █████████░",
                "  ██████████"
            ]
        }
    },
    "pulseaudio": {
        "scroll-step": 0.5,
            "max-volume": 150,
            "states": {
                "warning": 30,
                "normal": 89,
                "critical": 150
            },
            "format": "{icon} {volume}%",
            "format-icons": {
                "default": [
                    "  █░░░░░░░░░",
                "  ██░░░░░░░░",
                "  ███░░░░░░░",
                "  ████░░░░░░",
                "  █████░░░░░",
                "  ██████░░░░",
                "  ███████░░░",
                "  ████████░░",
                "  █████████░",
                "  ██████████",
                ],
            },
            "format-muted": " ",
            "on-click": "pavucontrol",
            "tooltip": false,
    },
    "memory": {
        "interval": 1,
        "format": "{icon} {used}G",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "format-icons": " "
    },
    "cpu": {
        "interval": 1,
        "states": {
            "warning": 50,
            "critical": 80
        },
        "format": "{icon} {usage}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "format-icons": ""
    }


}

